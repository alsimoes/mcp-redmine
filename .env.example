# Copy this file to .env and fill in your own values.
# Only needed if you run the server manually (see README.md, "Run locally").
# The usual way to configure it is the "env" block of your MCP client's
# server configuration, not a .env file.

# Base URL of your Redmine instance (no trailing slash).
REDMINE_URL=https://redmine.example.com

# My account > API access key.
REDMINE_API_KEY=your_api_key_here

# Optional: per-request timeout, in seconds. Defaults to 15.
# REDMINE_TIMEOUT=15
